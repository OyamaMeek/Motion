      "nearest_beat": 198.600272,
      "beat_delta": 0.220272
    },
    {
      "line": 28,
      "time": 203.49,
      "text": "想見不能見最痛",
      "nearest_beat": 203.430023,
      "beat_delta": -0.059977
    },
    {
      "line": 29,
      "time": 211.25,
      "text": "我發誓不再說謊了",
      "nearest_beat": 211.464127,
      "beat_delta": 0.214127
    },
    {
      "line": 30,
      "time": 215.32,
      "text": "多愛你就會抱你多緊的",
      "nearest_beat": 215.1561,
      "beat_delta": -0.1639
    },
    {
      "line": 31,
      "time": 219.95,
      "text": "我的微笑都假了 靈魂像飄浮著",
      "nearest_beat": 220.07873,
      "beat_delta": 0.12873
    },
    {
      "line": 32,
      "time": 224.92000000000002,
      "text": "你在就好了",
      "nearest_beat": 224.792381,
      "beat_delta": -0.127619
    },
    {
      "line": 33,
      "time": 228.47,
      "text": "我發誓不讓你等候",
      "nearest_beat": 228.623673,
      "beat_delta": 0.153673
    },
    {
      "line": 34,
      "time": 232.49,
      "text": "陪你做想做的無論什麼",
      "nearest_beat": 232.362086,
      "beat_delta": -0.127914
    },
    {
      "line": 35,
      "time": 236.72,
      "text": "我越來越像貝殼 怕心被人觸碰",
      "nearest_beat": 236.657778,
      "beat_delta": -0.062222
    },
    {
      "line": 36,
      "time": 242.14,
      "text": "你回來那就好了",
